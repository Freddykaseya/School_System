# Copier ce fichier en .env.local et le remplir. Ne jamais publier .env.local.

# --- Mode de fonctionnement --------------------------------------------
# ecole  (par défaut) : PC d'une école, base locale, fonctionne sans internet.
# centre             : serveur en ligne de l'administrateur, base Supabase.
ERP_MODE=ecole

# Mode école : dossier de la base locale (par défaut ./donnees-locales).
# ERP_DONNEES=C:\ERP-Ecole\donnees

# --- Base centrale (Supabase > Project Settings > API) -------------------
# Sur le PC d'une école : sert uniquement à la première connexion d'un
# compte (vérification en ligne et réception de la configuration).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Mode centre uniquement : connexion PostgreSQL directe à la base centrale
# (Supabase > Connect > Session pooler). Secret : jamais sur un PC d'école.
DATABASE_URL=

# Uniquement pour scripts/create-user.mjs (création des comptes). Jamais
# côté navigateur, jamais sur un PC d'école.
SUPABASE_SERVICE_ROLE_KEY=
